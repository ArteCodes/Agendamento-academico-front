# Variáveis de ambiente do Firebase (Vite - prefixo VITE_ obrigatório)
# Preencha com os valores do Firebase Console > Project Settings > General > Your apps > Configuração do SDK Firebase

VITE_FIREBASE_API_KEY=sua-api-key-do-firebase
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu-messaging-sender-id
VITE_FIREBASE_APP_ID=seu-app-id
VITE_API_BASE_URL=http://127.0.0.1:8000/api